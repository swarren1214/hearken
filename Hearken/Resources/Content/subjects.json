  "questions": [
    {
      "id": "q.bofm.0001", "subjectID": "bofm-history", "unitID": "bofm.u2",
      "prompt": "Who abridged the large plates of Nephi into most of the Book of Mormon?",
      "options": ["Nephi", "Mormon", "Moroni", "Mosiah"], "answer": 1,
      "reference": "Words of Mormon 1",
      "explanation": "Mormon abridged centuries of Nephite records onto the plates that bear his name; his son Moroni finished them."
    },
    {
      "id": "q.bofm.0002", "subjectID": "bofm-history", "unitID": "bofm.u2",
      "prompt": "Which of these happened first?",
      "options": ["Captain Moroni raises the title of liberty", "Samuel the Lamanite prophesies from the wall", "King Benjamin gives his final address", "Christ appears at the temple"], "answer": 2,
      "reference": "Mosiah 2–5",
      "explanation": "King Benjamin's address comes about 124 BC — roughly fifty years before the title of liberty and more than a century before Samuel."
    },
    {
      "id": "q.bofm.0003", "subjectID": "bofm-history", "unitID": "bofm.u2",
      "prompt": "Where did Alma baptize those who believed Abinadi's words?",
      "options": ["River Sidon", "Waters of Mormon", "Land of Bountiful", "City of Zarahemla"], "answer": 1,
      "reference": "Mosiah 18",
      "explanation": "Alma gathered believers in secret at the Waters of Mormon, where about 204 were baptized."
    },
    {
      "id": "q.bofm.0004", "subjectID": "bofm-history", "unitID": "bofm.u1",
      "prompt": "Roughly when did Lehi's family leave Jerusalem?",
      "options": ["c. 921 BC", "c. 600 BC", "c. 587 BC", "c. 124 BC"], "answer": 1,
      "reference": "1 Nephi 1–2",
      "explanation": "They left around 600 BC, in the first year of Zedekiah's reign — before Babylon destroyed Jerusalem in 587 BC."
    },
    {
      "id": "q.bofm.0005", "subjectID": "bofm-history", "unitID": "bofm.u4",
      "prompt": "The resurrected Christ first appeared to the Nephites at the temple in which land?",
      "options": ["Zarahemla", "Bountiful", "Nephi", "Desolation"], "answer": 1,
      "reference": "3 Nephi 11",
      "explanation": "A multitude gathered around the temple in the land Bountiful when they heard the Father's voice introduce His Son."
    },
    {
      "id": "q.bofm.0006", "subjectID": "bofm-history", "unitID": "bofm.u3",
      "prompt": "In Alma 32, Alma compares the word of God to what?",
      "options": ["A lamp", "A seed", "A river", "A sword"], "answer": 1,
      "reference": "Alma 32:28", "chapterID": "bofm.alma.32",
      "explanation": "Alma invites his listeners to plant the word like a seed and watch whether it swells, sprouts and grows."
    },
    {
      "id": "q.bofm.0007", "subjectID": "bofm-history", "unitID": "bofm.u3",
      "prompt": "Who was Alma teaching in Alma 32?",
      "options": ["The humble poor among the Zoramites", "The Nephite chief judges", "The people of Ammonihah", "The sons of Mosiah"], "answer": 0,
      "reference": "Alma 32", "chapterID": "bofm.alma.32",
      "explanation": "The poor had been cast out of the Zoramite synagogues, and Alma taught them that humility prepared them to receive the word."
    },
    {
      "id": "q.bofm.0008", "subjectID": "bofm-history", "unitID": "bofm.u3",
      "prompt": "According to Alma 32:27, what is enough to begin the experiment upon the word?",
      "options": ["A perfect knowledge", "A sign from heaven", "Even a desire to believe", "A witness from an angel"], "answer": 2,
      "reference": "Alma 32:27", "chapterID": "bofm.alma.32",
      "explanation": "Alma says that if they can no more than desire to believe, they should let that desire work in them."
    },
    {
      "id": "q.bt.0001", "subjectID": "biblical-timeline", "unitID": "bt.u6",
      "prompt": "Which empire conquered the northern kingdom of Israel in 722 BC?",
      "options": ["Babylon", "Persia", "Assyria", "Egypt"], "answer": 2,
      "reference": "2 Kings 17",
      "explanation": "Assyria took Samaria and carried the northern tribes away; Judah fell to Babylon more than a century later, in 587 BC."
    },
    {
      "id": "q.bt.0002", "subjectID": "biblical-timeline", "unitID": "bt.u5",
      "prompt": "Who built the first temple in Jerusalem?",
      "options": ["David", "Solomon", "Hezekiah", "Zerubbabel"], "answer": 1,
      "reference": "1 Kings 6",
      "explanation": "David prepared for it, but his son Solomon built the temple; Zerubbabel led the rebuilding after the exile."
    }
  ]
